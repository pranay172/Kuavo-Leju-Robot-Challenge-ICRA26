# Public upstream revisions used for every result in this repository.
# Sourced by upstream/setup_upstream.sh.

# Challenge code: training, LeRobot patches, deployment (inference) code.
KDC_URL=https://github.com/LejuRobotics/kuavo_data_challenge.git
KDC_BRANCH=icra
KDC_COMMIT=b0a4ec484dc31e650cc4ca761f16c2662aef94ff
# Submodule third_party/lerobot as recorded by KDC_COMMIT (v0.4.1-1, reports version 0.4.2).
LEROBOT_COMMIT=d9e74a9d374a8f26582ad326c699740a227b483c

# Simulator: ROS workspace with the data_challenge_simulator package.
KUAVO_ROS_URL=https://github.com/LejuRobotics/kuavo-ros-opensource.git
KUAVO_ROS_BRANCH=opensource/kuavo-data-challenge-icra
KUAVO_ROS_COMMIT=ded65260c33df70bb6020f7a7d086a5a1529367f

# Simulator Docker image published by Leju (see the kuavo-ros-opensource readme on that branch).
SIM_IMAGE_URL=https://kuavo.lejurobot.com/docker_images/kuavo_opensource_mpc_wbc_img_v0.6.1.tar.gz
SIM_IMAGE=kuavo_opensource_mpc_wbc_img:0.6.1
